# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Local secrets / machine state (never publish)
.env
.env.*
*.pem
id_rsa
id_rsa.pub
credentials.json
**/INSTALLATION.json

# Tool download cache (machine-local; the shipped copies live in offline/)
BUNDLED-TOOLS/cache/

# Python / node local junk if someone runs tools in-tree
__pycache__/
*.pyc
node_modules/
.venv/
venv/

# Git / IDE
.idea/
.vscode/
*.log

# Machine-local inventory (another machine must regenerate it)
TOOLBELT.md

# Extracted copies of shipped archives (the .zip/.whl next to them are canonical)
BUNDLED-TOOLS/offline/*/
2-OPTIONAL-MANUAL-OTHER-GAMES-MEGA-PACK/Other-Games-Modding-Skills-Mega-Pack-v2.1.0/

# Release artifacts from TOOLS/Build-Release.ps1 and TOOLS/build_release.py.
# The Python builder defaults to --outdir artifacts, which is also what CI
# uses, so a release build left ~180MB untracked and one `git add -A` away
# from being committed.
dist/
artifacts/

# Written into a project by TOOLS\Set-McpProfile.ps1 and by Serena itself when
# a capability profile is enabled for that project. Machine-local wiring, not
# pack content -- and this repository is one of the projects it can be enabled
# for, where an untracked .grok\config.toml would fail the manifest verifier.
.grok/
.serena/

# Written by TESTS/evidence-scenarios/check_fixtures.py when it proves scenario C
# still fails. Output of running a fixture, not pack content.
TESTS/evidence-scenarios/*/app.log
