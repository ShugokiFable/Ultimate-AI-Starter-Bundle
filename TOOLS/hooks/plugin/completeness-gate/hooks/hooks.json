{
  "description": "Completeness and assumption gates - refuse a half-finished release and an unverified path.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|Terminal|PowerShell|run_command|execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/completeness_gate.py\" --pre",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/assumption_gate.py\" --pre",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|write_file|create_file|str_replace.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/assumption_gate.py\" --pre",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/completeness_gate.py\" --stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/assumption_gate.py\" --stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
