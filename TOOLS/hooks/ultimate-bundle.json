{
  "_comment": [
    "Ultimate AI Starter Bundle - completeness + assumption gates.",
    "Claude-compatible hook shape. Grok and Codex plugins read this format too.",
    "Kimi has no hook system. Hermes is wired by hermes_wire.py, not this file.",
    "Replace <PYTHON> and <HOOKS> at install time; Install-Completeness-Gate.ps1 does this."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|Terminal|PowerShell|run_command|execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> \"<HOOKS>/completeness_gate.py\" --pre",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "<PYTHON> \"<HOOKS>/assumption_gate.py\" --pre",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|write_file|create_file|str_replace.*",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> \"<HOOKS>/assumption_gate.py\" --pre",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> \"<HOOKS>/completeness_gate.py\" --stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "<PYTHON> \"<HOOKS>/assumption_gate.py\" --stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
