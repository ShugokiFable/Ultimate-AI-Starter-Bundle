    {
      "id": "playwright-mcp",
      "name": "Playwright MCP",
      "kind": "mcp-npx",
      "install": "mcp-npx",
      "mcp": true,
      "github": {
        "owner": "microsoft",
        "repo": "playwright-mcp"
      },
      "npx_command": "npx",
      "npx_args": [
        "@playwright/mcp@latest"
      ],
      "extra_args_env": "PLAYWRIGHT_MCP_EXECUTABLE_PATH",
      "extra_args_template": [
        "--executable-path",
        "{value}"
      ],
      "api_key_env": null,
      "providers": [
        "Grok",
        "Codex",
        "Kimi",
        "Hermes"
      ],
      "runtimes": [
        "node22"
      ],
      "license": "Apache-2.0",
      "required_for": [
        "browser-automation"
      ],
      "offline_asset": null,
      "scope_note": "Browser automation for CLIs with no built-in browser. Claude Code already ships a browser pane, so it is skipped there. Never used for Nexus lookups - houseCARL does those keylessly. BROWSER CHOICE: with no flags, playwright-mcp defaults to the Google Chrome channel and prompts you to install Chrome. To use your own browser (Opera GX, Edge, Brave, Vivaldi, ...), set user env PLAYWRIGHT_MCP_EXECUTABLE_PATH to the browser exe BEFORE running the installer - the wiring appends --executable-path automatically. Example (Opera GX): setx PLAYWRIGHT_MCP_EXECUTABLE_PATH \"%LOCALAPPDATA%\\Programs\\Opera GX\\opera.exe\". To change later, edit the args in your provider's MCP config (Grok/Codex config.toml, Kimi ~/.kimi-code/mcp.json)."
    },
